# Copy to .env and fill in. All keys are optional — app degrades gracefully if missing.

# Claude API — required for research note generation
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# FRED API — free, required for US macro data
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# screener.in PREMIUM — when subscribed (₹2,500/yr), paste session cookie below to unlock
# historical financials + remove ticker 404 issues. Find cookie via browser devtools:
#   1. Log in at https://www.screener.in/
#   2. Open DevTools → Application → Cookies → screener.in
#   3. Copy value of `sessionid` and paste below
SCREENER_PREMIUM_SESSIONID=

# Paid data providers (Phase 3+) — for future expansion
TIJORI_API_KEY=
TRENDLYNE_API_KEY=
SMALLCASE_API_KEY=
