# Example secrets file for Streamlit Cloud deployment.
# DO NOT put real values here. The real values go into Streamlit Cloud's "Secrets"
# UI (Settings → Secrets) which writes them server-side as environment variables.
# Read more: https://docs.streamlit.io/streamlit-community-cloud/deploy-your-app/secrets-management
#
# To deploy: copy the keys below into Streamlit Cloud's Secrets editor and paste your real values.

ANTHROPIC_API_KEY = "sk-ant-api03-..."
SCREENER_PREMIUM_SESSIONID = "your-32-char-sessionid-cookie"
FRED_API_KEY = ""  # optional — for US macro panel

# Future paid providers (leave blank for now)
TIJORI_API_KEY = ""
TRENDLYNE_API_KEY = ""
SMALLCASE_API_KEY = ""
